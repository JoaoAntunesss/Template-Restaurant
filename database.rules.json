{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },
    "cardapio": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "pratos": {
        "$id": {
          ".validate": "newData.hasChildren(['nome','preco','cat']) && newData.child('nome').isString() && newData.child('nome').val().length <= 80 && newData.child('preco').isNumber() && (!newData.child('foto').exists() || (newData.child('foto').isString() && newData.child('foto').val().length < 200000))"
        }
      },
      "pedidos": { ".validate": "newData.isBoolean()" }
    },
    "mesas": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$m": {
        ".validate": "newData.hasChildren(['num','nome','codigo']) && newData.child('num').isNumber() && newData.child('nome').isString() && newData.child('nome').val().length <= 40 && newData.child('codigo').isString()"
      }
    },
    "codigos": {
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$c": {
        ".read": true,
        ".validate": "newData.hasChildren(['mesa','nome'])"
      }
    },
    "contas": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$c": {
        ".read": "root.child('codigos').child($c).exists()",
        "pedidos": {
          "$p": {
            ".write": "!data.exists() && newData.exists() && root.child('codigos').child($c).exists() && root.child('cardapio/pedidos').val() === true",
            ".validate": "newData.hasChildren(['itens','criadoEm']) && (data.exists() || newData.child('criadoEm').val() === now)",
            "itens": {
              "$i": {
                ".validate": "(($i === 'pratoDia' && root.child('cardapio/pratoDia/ativo').val() === true) || ($i !== 'pratoDia' && root.child('cardapio/pratos').child($i).exists())) && newData.child('q').isNumber() && newData.child('q').val() >= 1 && newData.child('q').val() <= 30 && newData.child('n').isString() && newData.child('n').val().length <= 80",
                "$x": { ".validate": "$x === 'q' || $x === 'n'" }
              }
            },
            "nota": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "criadoEm": { ".validate": "newData.isNumber()" },
            "visto": { ".validate": "newData.isBoolean()" },
            "$outro": { ".validate": false }
          }
        },
        "chamada": {
          ".write": "root.child('codigos').child($c).exists() && root.child('cardapio/pedidos').val() === true",
          ".validate": "newData.hasChildren(['tipo','em']) && (newData.child('tipo').val() === 'empregado' || newData.child('tipo').val() === 'conta') && newData.child('em').val() === now"
        },
        "$outro": { ".validate": false }
      }
    }
  }
}
